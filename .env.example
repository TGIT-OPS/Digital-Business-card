# Copy this file to .env and fill in the values from your Supabase project.
# Never commit .env. This repository is public.

# Project URL. Supabase → Project Settings → API → Project URL.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# anon public key. Safe to expose in the browser. RLS protects the data.
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key. Server only. Used to create the super admin profile,
# upload seed logos, and record analytics. Never put this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The only person who can sign in. Must match the user you create in Supabase Auth.
SUPER_ADMIN_EMAIL=you@tgitsolutions.com

# Used only by `npm run seed` to create that user. Remove it after seeding
# if you do not want the password sitting in .env. The running app does not read it.
SUPER_ADMIN_PASSWORD=choose-a-long-password

# Public origin baked into QR codes, copied links, and vCards.
# Production default is https://cards.tgitsolutions.com
PUBLIC_BASE_URL=https://cards.tgitsolutions.com
